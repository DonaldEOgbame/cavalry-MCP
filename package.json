{
  "name": "cavalry-mcp",
  "version": "1.0.0",
  "description": "Autonomous Model Context Protocol server for Cavalry motion design",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cavalry-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/unit/*.test.ts tests/bridge/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "coverage:api": "node scripts/generate-api-coverage.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^18.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
