# Cavalry MCP Configuration

# Host and port for the Cavalry Bridge (inside Cavalry)
CAVALRY_BRIDGE_HOST=127.0.0.1
CAVALRY_BRIDGE_PORT=8080

# Response callback port hosted by the MCP server (for ultra-low-latency callbacks)
CAVALRY_CALLBACK_PORT=8082

# Bridge connection timeout in milliseconds
CAVALRY_BRIDGE_TIMEOUT_MS=15000
# Deadline for a render job (supervised pipeline and render_status polling).
CAVALRY_RENDER_TIMEOUT_MS=1800000

# MCP schema surface: core avoids sending every specialist schema over stdio;
# full explicitly exposes all 404 registered tools.
CAVALRY_TOOL_PROFILE=core

# Security Tier: SAFE | EXTENDED | RAW | SYSTEM_EXEC
CAVALRY_SECURITY_TIER=SAFE

# Escape Hatch: Level 2 Raw Scripting (false by default)
CAVALRY_ALLOW_RAW_SCRIPT=false
# Optional OS process execution escape hatch (requires SYSTEM_EXEC policy)
CAVALRY_ALLOW_SYSTEM_EXEC=false

# Writable application data root. Defaults to the platform user-data folder,
# never the package directory or current working directory.
CAVALRY_DATA_DIR=

# Allowed Filesystem Paths (comma-separated, defaults to project root + temp)
CAVALRY_ALLOWED_ROOTS=

# Output preview folder (defaults to os.tmpdir()/cavalry-previews)
CAVALRY_PREVIEW_DIR=

# Logging level: debug | info | warn | error
CAVALRY_LOG_LEVEL=info
# Knowledge Engine defaults to dependency-free local hash vectors. Remote embeddings
# are optional and fall back locally if unavailable. Primary/fallback dimensions must match.
CAVALRY_KNOWLEDGE_EMBEDDING_MODE=local
# CAVALRY_KNOWLEDGE_EMBEDDING_ENDPOINT=https://example.test/v1/embeddings
# CAVALRY_KNOWLEDGE_EMBEDDING_MODEL=embedding-model-name
# CAVALRY_KNOWLEDGE_EMBEDDING_API_KEY=
# CAVALRY_KNOWLEDGE_EMBEDDING_DIMENSIONS=256

# Runtime reliability (see docs/runtime-reliability.md)
# Render supervision windows (ms): no output growth after the native call
# returns / while it still blocks / empty container with an idle host.
# CAVALRY_RENDER_STALL_MS=120000
# CAVALRY_RENDER_BLOCKED_STALL_MS=600000
# CAVALRY_RENDER_ZERO_BYTE_GRACE_MS=90000
# Allow clean-host recovery (terminate, relaunch, reopen checkpoint) on macOS.
CAVALRY_WATCHDOG_AUTO_RESTART=false
# Opt-in macOS Accessibility probe for a visible Cavalry error dialog.
# CAVALRY_DIALOG_PROBE=false
# Evidence files (defaults under CAVALRY_DATA_DIR).
# CAVALRY_INCIDENT_LOG=
# CAVALRY_TRANSCRIPT_PATH=
# Cavalry's own log file, captured by the live benchmark and hygiene runs.
# CAVALRY_LOG_PATH=
# Test-only fault injection, set by the launching harness, never by a client:
# render.kill_host_after_start | render.stall | render.corrupt_output | render.fail_configure[:count]
# CAVALRY_FAULT_INJECTION=
